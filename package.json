{
  "name": "mongjin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bot:selfplay": "npx tsx scripts/bot-selfplay.ts",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "ait:install": "node scripts/ait-install.mjs",
    "dev:ait": "npm run ait:install && ait dev",
    "build:ait": "npm run ait:install && ait build",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:ios": "npm run cap:sync && npx cap run ios --target 265B8BD9-91BD-4009-8F71-7BD9D76D841D",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@phosphor-icons/web": "^2.1.2"
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "^2.7.0",
    "@capacitor/cli": "^8.4.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "^2.4.1",
    "@toss/tds-mobile-ait": "^2.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
