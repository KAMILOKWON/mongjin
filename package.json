{
  "name": "mongjin",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:app": "vite --host --open /?app=1",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "build:mobile": "npm run build --prefix apps/mobile",
    "build:android:release": "bash scripts/build-mongjin-android-release.sh",
    "validate:store-metadata": "node scripts/validate-store-metadata.mjs",
    "typecheck:mobile": "npm run typecheck --prefix apps/mobile",
    "device:doctor": "agent-device doctor",
    "device:help": "agent-device help workflow",
    "device:ios": "agent-device open com.studiozzg.mongjin.dev --platform ios --session mongjin-ios",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bot:selfplay": "npx tsx scripts/bot-selfplay.ts",
    "bot:bench": "npx tsx scripts/bot-bench.ts",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "dev:ait": "npm run dev:ait --prefix apps/toss",
    "build:ait": "npm run build:ait --prefix apps/toss",
    "test:ios": "swift test --package-path apps/ios",
    "build:ios": "xcodebuild -project apps/ios/Mongjin.xcodeproj -scheme Mongjin -configuration Release -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "upload:ios": "bash scripts/upload-ios-appstore.sh",
    "build:steam-web": "vite build --config vite.config.steam.ts",
    "build:steam": "npm run build:steam-web && npm run package --prefix apps/steam"
  },
  "dependencies": {
    "expo": "^57.0.14",
    "expo-dev-client": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "agent-device": "^0.20.3",
    "typescript": "~6.0.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
