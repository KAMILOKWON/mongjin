{
  "name": "mongjin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:app": "vite --host --open /?app=1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bot:selfplay": "npx tsx scripts/bot-selfplay.ts",
    "bot:bench": "npx tsx scripts/bot-bench.ts",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "ait:install": "node scripts/ait-install.mjs",
    "dev:ait": "npm run ait:install && ait dev",
    "build:ait": "npm run ait:install && ait build",
    "test:ios": "swift test --package-path apps/ios",
    "build:ios": "xcodebuild -project apps/ios/Mongjin.xcodeproj -scheme Mongjin -configuration Release -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0"
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "^2.7.0",
    "@capacitor/cli": "^8.4.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "^2.4.1",
    "@toss/tds-mobile-ait": "^2.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
