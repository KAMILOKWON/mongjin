{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals", "vite/client"],
    "paths": {
      "@apps-in-toss/web-framework": ["./src/stubs/apps-in-toss.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/ait/**"]
}
