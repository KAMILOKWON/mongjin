# 몽진 온라인 서버 환경변수 예시

# 서버가 수신할 포트 (기본 3001)
PORT=3001

# 프로필 전적 저장 파일 경로 (기본 <cwd>/data/profiles.json)
MONGJIN_PROFILE_DATA_FILE=./data/profiles.json

# 운영 환경에서는 반드시 영속 Postgres 연결 문자열을 설정한다.
# 설정하면 로컬 JSON 대신 Postgres가 프로필과 Elo 경기 기록의 원본이 된다.
DATABASE_URL=

# Postgres 연결 풀 크기 (기본 5)
DATABASE_POOL_SIZE=5
