# 몽진 온라인 서버 환경변수 예시

# 서버가 수신할 포트 (기본 3001)
PORT=3001

# 프로필 전적 저장 파일 경로 (기본 <cwd>/data/profiles.json)
MONGJIN_PROFILE_DATA_FILE=./data/profiles.json

# 운영 환경에서는 반드시 영속 Postgres 연결 문자열을 설정한다.
# 설정하면 로컬 JSON 대신 Postgres가 프로필과 Elo 경기 기록의 원본이 된다.
DATABASE_URL=

# Postgres 연결 풀 크기 (기본 5)
DATABASE_POOL_SIZE=5

# 사람 상대 매칭 대기 시간(ms). 이 시간이 지나도 상대가 없으면 AI와 매칭 (기본 15000)
AI_FALLBACK_MS=15000

# --- 토스 로그인 연동 (모두 설정하지 않으면 토스 로그인 비활성화) ---

# 토스 API mTLS 클라이언트 인증서 PEM 파일 경로
TOSS_MTLS_CERT_PATH=

# 토스 API mTLS 클라이언트 개인키 PEM 파일 경로
TOSS_MTLS_KEY_PATH=

# 토스 사용자 정보 복호화용 AES-256 키 (base64)
TOSS_DECRYPT_KEY=

# 토스 사용자 정보 복호화용 AAD 문자열
TOSS_DECRYPT_AAD=

# 연결 해제 콜백(/toss/unlink-callback) Basic 인증의 디코딩된 기대값 (예: "user:password")
TOSS_CALLBACK_BASIC_AUTH=
